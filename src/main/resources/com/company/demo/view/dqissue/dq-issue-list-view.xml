<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://dqIssueListView.title"
      focusComponent="dqIssuesDataGrid">
    <data>
        <collection id="dqIssuesDc"
                    class="com.company.demo.entity.DqIssue">
            <fetchPlan extends="_base">
                <property name="rule" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqIssuesDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_DqIssue e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="dqIssuesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="readButton" action="dqIssuesDataGrid.readAction"/>
                <button id="setAssigneeButton" action="dqIssuesDataGrid.setAssigneeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="dqIssuesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="dqIssuesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="dqIssuesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="readAction" type="list_read"/>
                <!-- itemTracking: enabled only while a row is selected -->
                <action id="setAssigneeAction"
                        type="list_itemTracking"
                        text="msg://dqIssueListView.setAssigneeAction"
                        icon="vaadin:user"/>
            </actions>
            <columns resizable="true">
                <column property="rule" autoWidth="true" flexGrow="0"/>
                <column property="dataSource" autoWidth="true" flexGrow="0"/>
                <column property="status" autoWidth="true" flexGrow="0"/>
                <column property="severity" autoWidth="true" flexGrow="0"/>
                <column property="title" autoWidth="true" flexGrow="0"/>
                <column property="assigneName" autoWidth="true" flexGrow="0"/>
                <column property="assigneeEmail" autoWidth="true" flexGrow="0"/>
                <column property="assigneePhone" autoWidth="true" flexGrow="0"/>
                <column property="dueDate" autoWidth="true" flexGrow="0"/>
                <column property="resolvedAt" autoWidth="true" flexGrow="0"/>
                <column property="affectedRows" autoWidth="true" flexGrow="0"/>
                <column property="createdAt" autoWidth="true" flexGrow="0"/>
                <column property="updatedAt" autoWidth="true" flexGrow="0"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
