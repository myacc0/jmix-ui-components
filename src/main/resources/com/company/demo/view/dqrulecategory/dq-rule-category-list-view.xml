<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://dqRuleCategoryListView.title"
      focusComponent="dqRuleCategoriesDataGrid">
    <data>
        <collection id="dqRuleCategoriesDc"
                    class="com.company.demo.entity.DqRuleCategory">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRuleCategoriesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="dqRuleCategoriesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="dqRuleCategoriesDataGrid.createAction"/>
                <button id="editButton" action="dqRuleCategoriesDataGrid.editAction"/>
                <button id="removeButton" action="dqRuleCategoriesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="dqRuleCategoriesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="dqRuleCategoriesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="dqRuleCategoriesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name"/>
                <column property="description"/>
                <column property="parent"/>
                <column property="createdAt"/>
                <column property="updatedAt"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
