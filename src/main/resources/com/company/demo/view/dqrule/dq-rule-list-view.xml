<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://dqRuleListView.title"
      focusComponent="dqRulesDataGrid">
    <data>
        <collection id="dqRulesDc" class="com.company.demo.entity.DqRule">
            <fetchPlan>
                <property name="id" />
                <property name="name" />
                <property name="dataSource" />
                <property name="dimension" />
                <property name="ruleType" />
                <property name="severity" />
                <property name="active" />
                <property name="createdAt" />
                <property name="updatedAt" />
                <property name="owner" fetchPlan="_instance_name"/>
                <property name="category" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRulesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="dqRulesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="dqRulesDataGrid.createAction"/>
                <button id="editButton" action="dqRulesDataGrid.editAction"/>
                <button id="removeButton" action="dqRulesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="dqRulesDl" itemsPerPageDefaultValue="20"/>
            </endSlot>
        </hbox>
        <dataGrid id="dqRulesDataGrid"
                  width="100%"
                  minHeight="20em"
                  allRowsVisible="true"
                  pageSize="20"
                  dataContainer="dqRulesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="name" autoWidth="true"/>
                <column property="dataSource" autoWidth="true"/>
                <column property="dimension" autoWidth="true"/>
                <column property="ruleType" autoWidth="true"/>
                <column property="severity" autoWidth="true"/>
                <column property="active" autoWidth="true"/>
                <column property="owner" autoWidth="true"/>
                <column property="category" autoWidth="true"/>
                <column property="createdAt" autoWidth="true"/>
                <column property="updatedAt" autoWidth="true"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
