<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://com.company.demo/schema/app-ui-components"
      title="msg://dqRuleDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dqRuleDc" class="com.company.demo.entity.DqRule">
            <fetchPlan extends="_base">
                <property name="group" fetchPlan="_instance_name"/>
                <property name="owner" fetchPlan="_instance_name"/>
                <property name="domain" fetchPlan="_instance_name"/>
                <property name="dataProduct" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRuleDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout
                id="form"
                dataContainer="dqRuleDc"
                autoResponsive="true"
                width="50%"
                expandColumns="true"
                expandFields="true">
            <formItem label="msg://com.company.demo.entity/DqRule.name">
                <textField id="nameField" property="name"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.description">
                <textArea id="descriptionField" property="description" minRows="5"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.group">
                <entityPicker id="groupField" property="group" required="true">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.domain">
                <entityPicker id="domainField" property="domain" required="true">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.dataProduct">
                <entityPicker id="dataProductField" property="dataProduct">
                    <actions>
                        <action id="entityLookupAction" type="entity_lookup"/>
                        <action id="entityClearAction" type="entity_clear"/>
                    </actions>
                </entityPicker>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.dimension">
                <select id="dimensionField" property="dimension"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.severity">
                <select id="severityField" property="severity"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.dataSource">
                <select id="dataSourceField" property="dataSource"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.dbSchema">
                <comboBox id="dbSchemaField" property="dbSchema"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.tableName">
                <comboBox id="tableNameField" property="tableName"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.columnName">
                <comboBox id="columnNameField" property="columnName"/>
            </formItem>
            <formItem label="msg://com.company.demo.entity/DqRule.ruleType">
                <select id="ruleTypeField" property="ruleType"/>
            </formItem>
        </formLayout>

        <vbox id="ruleConfigFields" padding="false" width="50%">
            <formLayout width="100%">
                <responsiveSteps>
                    <responsiveStep minWidth="0" columns="1"/>
                </responsiveSteps>
                <app:slider id="thresholdField" label="msg://ruleConfig.threshold" min="0" max="100" value="100"/>
                <numberField id="sampleSizeField" label="msg://ruleConfig.sampleSize" stepButtonsVisible="true"/>
            </formLayout>

            <vbox id="rangeBox" visible="false" padding="false" width="100%">
                <formLayout>
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="2"/>
                    </responsiveSteps>
                    <numberField id="minNumberField" label="msg://ruleConfig.min"/>
                    <datePicker id="minDateField" label="msg://ruleConfig.min"/>
                    <checkbox id="minIncludedField" label="msg://ruleConfig.minIncluded"/>
                </formLayout>
                <formLayout>
                    <responsiveSteps>
                        <responsiveStep minWidth="0" columns="2"/>
                    </responsiveSteps>
                    <numberField id="maxNumberField" label="msg://ruleConfig.max"/>
                    <datePicker id="maxDateField" label="msg://ruleConfig.max"/>
                    <checkbox id="maxIncludedField" label="msg://ruleConfig.maxIncluded"/>
                </formLayout>
            </vbox>

            <formLayout id="regexpBox" visible="false" width="100%">
                <textField id="regexpField" label="msg://ruleConfig.regexp"/>
            </formLayout>
        </vbox>

        <formLayout dataContainer="dqRuleDc"
                    autoResponsive="true"
                    width="50%"
                    expandColumns="true"
                    expandFields="true" rowSpacing="10px">
            <formItem label="msg://com.company.demo.entity/DqRule.ruleConfig">
                <textArea id="ruleConfigField" property="ruleConfig" minRows="5" readOnly="true"/>
            </formItem>
            <checkbox id="activeField" property="active" label="msg://com.company.demo.entity/DqRule.active"/>
        </formLayout>

        <hbox id="detailActions" width="50%" justifyContent="CENTER" css="padding-bottom: 40px">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
