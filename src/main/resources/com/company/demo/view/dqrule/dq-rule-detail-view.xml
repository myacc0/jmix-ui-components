<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqRuleDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dqRuleDc"
                  class="com.company.demo.entity.DqRule">
            <fetchPlan extends="_base">
                <property name="owner" fetchPlan="_instance_name"/>
                <property name="category" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRuleDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="dqRuleDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="nameField" property="name"/>
            <textField id="descriptionField" property="description"/>
            <select id="dataSourceField" property="dataSource"/>
            <textField id="tableNameField" property="tableName"/>
            <textField id="columnNameField" property="columnName"/>
            <select id="dimensionField" property="dimension"/>
            <select id="ruleTypeField" property="ruleType"/>
            <textField id="ruleConfigField" property="ruleConfig"/>
            <select id="severityField" property="severity"/>
            <checkbox id="activeField" property="active"/>
            <entityPicker id="ownerField" property="owner">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="categoryField" property="category">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
