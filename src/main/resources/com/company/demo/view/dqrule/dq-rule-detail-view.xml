<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqRuleDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dqRuleDc" class="com.company.demo.entity.DqRule">
            <fetchPlan extends="_base">
                <property name="owner" fetchPlan="_instance_name"/>
                <property name="category" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRuleDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout
                id="form"
                dataContainer="dqRuleDc"
                autoResponsive="true"
                width="100%"
                minColumns="1"
                maxColumns="2"
                expandColumns="true"
                expandFields="true">
            <formRow>
                <formItem label="msg://com.company.demo.entity/DqRule.name">
                    <textField id="nameField" property="name"/>
                </formItem>
                <formItem label="msg://com.company.demo.entity/DqRule.active">
                    <checkbox id="activeField" property="active"/>
                </formItem>
            </formRow>

            <formRow>
                <formItem label="msg://com.company.demo.entity/DqRule.description" colspan="2">
                    <textArea id="descriptionField" property="description" colspan="2"/>
                </formItem>
            </formRow>

            <formRow>
                <formItem label="msg://com.company.demo.entity/DqRule.owner">
                    <entityPicker id="ownerField" property="owner">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formItem>
                <formItem label="msg://com.company.demo.entity/DqRule.category">
                    <entityPicker id="categoryField" property="category">
                        <actions>
                            <action id="entityLookupAction" type="entity_lookup"/>
                            <action id="entityClearAction" type="entity_clear"/>
                        </actions>
                    </entityPicker>
                </formItem>
            </formRow>

            <formRow>
                <formItem label="msg://com.company.demo.entity/DqRule.dimension">
                    <select id="dimensionField" property="dimension"/>
                </formItem>
                <formItem label="msg://com.company.demo.entity/DqRule.severity">
                    <select id="severityField" property="severity"/>
                </formItem>
            </formRow>

            <formRow>
                <formItem label="msg://com.company.demo.entity/DqRule.dataSource">
                    <select id="dataSourceField" property="dataSource" />
                </formItem>
                <formItem label="msg://com.company.demo.entity/DqRule.tableName">
                    <textField id="tableNameField" property="tableName"/>
                </formItem>
                <formItem label="msg://com.company.demo.entity/DqRule.columnName">
                    <textField id="columnNameField" property="columnName"/>
                </formItem>
            </formRow>

            <formRow>
                <formItem label="msg://com.company.demo.entity/DqRule.ruleType">
                    <select id="ruleTypeField" property="ruleType"/>
                </formItem>
                <formItem label="msg://com.company.demo.entity/DqRule.ruleConfig">
                    <textArea id="ruleConfigField" property="ruleConfig" colspan="2"/>
                </formItem>
            </formRow>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
