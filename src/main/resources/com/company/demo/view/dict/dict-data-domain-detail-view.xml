<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dictDataDomainDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dictDataDomainDc"
                  class="com.company.demo.entity.dict.DictDataDomain">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name">
                    <property name="parent" fetchPlan="_instance_name"/>
                </property>
                <property name="businessOwner" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dictDataDomainDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_save"/>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <tabSheet id="tabSheet" width="100%">
            <tab id="mainTab" label="msg://mainTab.label">
                <vbox id="mainTabContent" width="50%" padding="false">
                    <formLayout id="form"
                                dataContainer="dictDataDomainDc"
                                autoResponsive="true"
                                width="100%"
                                expandColumns="true"
                                expandFields="true">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="1" />
                        </responsiveSteps>

                        <entityPicker id="parentField" property="parent" dataContainer="dictDataDomainDc">
                            <actions>
                                <action id="entityLookupAction" type="entity_lookup"/>
                                <action id="entityClearAction" type="entity_clear"/>
                            </actions>
                        </entityPicker>
                        <textField id="codeField" property="code" dataContainer="dictDataDomainDc"/>

                        <entityPicker id="businessOwnerField" property="businessOwner" dataContainer="dictDataDomainDc">
                            <actions>
                                <action id="entityLookupAction" type="entity_lookup"/>
                                <action id="entityClearAction" type="entity_clear"/>
                            </actions>
                        </entityPicker>
                        <datePicker id="assignDateField" property="assignDate" dataContainer="dictDataDomainDc"/>

                        <div classNames="form-lang-group">
                            <formItem label="msg://com.company.demo.entity.dict/DictDataDomain.shortNameRu">
                                <textField id="shortNameRuField" property="shortNameRu"/>
                            </formItem>
                            <formItem label="msg://com.company.demo.entity.dict/DictDataDomain.shortNameUz">
                                <textField id="shortNameUzField" property="shortNameUz"/>
                            </formItem>
                        </div>
                        <div classNames="form-lang-group">
                            <formItem label="msg://com.company.demo.entity.dict/DictDataDomain.longNameRu">
                                <textField id="longNameRuField" property="longNameRu"/>
                            </formItem>
                            <formItem label="msg://com.company.demo.entity.dict/DictDataDomain.longNameUz">
                                <textField id="longNameUzField" property="longNameUz"/>
                            </formItem>
                        </div>
                        <div classNames="form-lang-group">
                            <formItem label="msg://com.company.demo.entity.dict/DictDataDomain.descriptionRu">
                                <textArea id="descriptionRuField" property="descriptionRu" minRows="5"/>
                            </formItem>
                            <formItem label="msg://com.company.demo.entity.dict/DictDataDomain.descriptionUz">
                                <textArea id="descriptionUzField" property="descriptionUz" minRows="5"/>
                            </formItem>
                        </div>
                    </formLayout>
                </vbox>
            </tab>
            <tab id="stewardsTab" label="msg://stewardsTab.label" enabled="false">
                <fragment id="stewardsFragment"
                          class="com.company.demo.view.dict.DictDataDomainStewardListFragment"/>
            </tab>
        </tabSheet>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="saveButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
