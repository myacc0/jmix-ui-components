<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dictDataProductDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dictDataProductDc"
                  class="com.company.demo.entity.dict.DictDataProduct">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name">
                    <property name="parent" fetchPlan="_instance_name"/>
                </property>
                <property name="businessOwner" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dictDataProductDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_save"/>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <tabSheet id="tabSheet" width="100%">
            <tab id="mainTab" label="msg://mainTab.label">
                <vbox id="mainTabContent" width="50%" padding="false">
                    <formLayout id="form"
                                dataContainer="dictDataProductDc"
                                autoResponsive="true"
                                width="100%"
                                expandColumns="true"
                                expandFields="true">
                        <responsiveSteps>
                            <responsiveStep minWidth="0" columns="1" />
                        </responsiveSteps>

                        <entityPicker id="parentField" property="parent" dataContainer="dictDataProductDc">
                            <actions>
                                <action id="entityLookupAction" type="entity_lookup"/>
                                <action id="entityClearAction" type="entity_clear"/>
                            </actions>
                        </entityPicker>
                        <textField id="codeField" property="code" dataContainer="dictDataProductDc"/>
                        <textField id="shortNameField" property="shortName"/>
                        <textField id="longNameField" property="longName"/>
                        <entityPicker id="businessOwnerField" property="businessOwner" dataContainer="dictDataProductDc">
                            <actions>
                                <action id="entityLookupAction" type="entity_lookup"/>
                                <action id="entityClearAction" type="entity_clear"/>
                            </actions>
                        </entityPicker>
                        <datePicker id="assignDateField" property="assignDate" dataContainer="dictDataProductDc"/>
                        <textArea id="descriptionField" property="description" minRows="5"/>
                    </formLayout>
                </vbox>
            </tab>
            <tab id="stewardsTab" label="msg://stewardsTab.label" enabled="false">
                <fragment id="stewardsFragment"
                          class="com.company.demo.view.dict.DictDataProductStewardListFragment"/>
            </tab>
        </tabSheet>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="saveButton" action="saveAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
