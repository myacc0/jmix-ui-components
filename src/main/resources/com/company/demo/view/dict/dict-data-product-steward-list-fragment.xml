<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <data>
        <collection id="stewardsDc"
                    class="com.company.demo.entity.dict.DictDataProductSteward">
            <fetchPlan extends="_base">
                <property name="employee" fetchPlan="_instance_name"/>
            </fetchPlan>
            <!-- loaded by DictDataProductStewardListFragment.setProduct(), not by a coordinator:
                 the :product parameter is set only for a saved product -->
            <loader id="stewardsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_DictDataProductSteward e
                    where e.product = :product
                    order by e.dateBegin desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <content>
        <vbox id="root" width="100%" padding="false">
            <hbox id="buttonsPanel" classNames="buttons-panel">
                <button id="createButton" action="stewardsDataGrid.createAction" text="" title="msg:///actions.Create"/>
                <button id="editButton" action="stewardsDataGrid.editAction" text="" title="msg:///actions.Edit"/>
                <button id="removeButton" action="stewardsDataGrid.removeAction" text="" title="msg:///actions.Remove"/>
            </hbox>
            <dataGrid id="stewardsDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="stewardsDc"
                      columnReorderingAllowed="true">
                <actions>
                    <action id="createAction" type="list_create">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="editAction" type="list_edit">
                        <properties>
                            <property name="openMode" value="DIALOG"/>
                        </properties>
                    </action>
                    <action id="removeAction" type="list_remove"/>
                </actions>
                <columns resizable="true">
                    <column property="employee"/>
                    <column property="dateBegin"/>
                    <column property="dateEnd"/>
                    <column property="notes"/>
                </columns>
            </dataGrid>
        </vbox>
    </content>
</fragment>
