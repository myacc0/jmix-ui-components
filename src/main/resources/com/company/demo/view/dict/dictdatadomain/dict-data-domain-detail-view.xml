<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dictDataDomainDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dictDataDomainDc"
                  class="com.company.demo.entity.dict.DictDataDomain">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name">
                    <property name="parent" fetchPlan="_instance_name"/>
                </property>
                <property name="businessOwner" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dictDataDomainDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="dictDataDomainDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <entityPicker id="parentField" property="parent">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textField id="codeField" property="code"/>
            <textField id="shortNameField" property="shortName"/>
            <textField id="shortNameUzField" property="shortNameUz"/>
            <textField id="longNameField" property="longName"/>
            <textField id="longNameUzField" property="longNameUz"/>
            <entityPicker id="businessOwnerField" property="businessOwner">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <datePicker id="assignDateField" property="assignDate"/>
            <textField id="descriptionField" property="description"/>
            <textField id="descriptionUzField" property="descriptionUz"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
