<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://com.company.demo/schema/app-ui-components"
      title="msg://dataProductStructureView.title">
    <data>
        <collection id="productsDc" class="com.company.demo.entity.dict.DictDataProduct">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="productsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_DictDataProduct e order by e.shortName]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <split id="splitLayout" orientation="HORIZONTAL" width="100%" height="100%">
            <vbox id="productsPanel" width="30%" height="100%">
                <treeDataGrid id="productsTreeDataGrid"
                              dataContainer="productsDc"
                              hierarchyProperty="parent"
                              themeNames="no-header no-row-borders compact"
                              width="100%"
                              height="100%">
                    <columns sortable="false">
                        <column property="shortName"/>
                    </columns>
                </treeDataGrid>
            </vbox>

            <vbox id="chartPanel" width="70%" height="100%">
                <textField id="productSearchField"
                           placeholder="msg://dataProductStructureView.search"
                           width="40%"
                           valueChangeMode="LAZY"
                           clearButtonVisible="true">
                    <suffix>
                        <icon icon="SEARCH"/>
                    </suffix>
                </textField>
                <app:d3-org-chart id="d3OrgChart" classNames="d3-org-chart" nodeTemplate="DATA_ASSET"/>
            </vbox>
        </split>
    </layout>
</view>
