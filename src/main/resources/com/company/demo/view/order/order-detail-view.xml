<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://orderDetailView.title"
      focusComponent="form">
    <data>
        <instance id="orderDc"
                  class="com.company.demo.entity.starrocks.Order">
            <fetchPlan extends="_base">
                <property name="product" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="orderDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="orderDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
            </responsiveSteps>
            <textField id="idField" property="id"/>
            <entityPicker id="productField" property="product">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textField id="totalSumField" property="totalSum"/>
            <textField id="saleSumField" property="saleSum"/>
            <textField id="deliverySumField" property="deliverySum"/>
            <textField id="quantityField" property="quantity"/>
            <textField id="paymentMethodField" property="paymentMethod"/>
            <textField id="customerPhoneField" property="customerPhone"/>
            <textField id="customerEmailField" property="customerEmail"/>
            <textField id="customerAddressField" property="customerAddress"/>
            <textField id="customerNameField" property="customerName"/>
            <dateTimePicker id="orderDateField" property="orderDate"/>
            <textField id="notesField" property="notes"/>
        </formLayout>
        <hbox id="detailActions">
            <button id="saveAndCloseButton" action="saveCloseAction"/>
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
