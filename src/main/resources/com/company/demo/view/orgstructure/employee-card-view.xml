<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view">
    <layout>
        <hbox id="employeeSummaryBox" classNames="employee-card-summary" width="100%"
              padding="false" spacing="true" alignItems="START">
            <image id="employeePhotoImage" classNames="employee-card-photo" visible="false"/>
            <span id="employeePhotoPlaceholder" classNames="employee-card-photo employee-card-photo-initials"/>

            <vbox id="employeeCardHeader" classNames="employee-card-header" padding="false" spacing="false">
                <h4 id="employeeNameLabel"/>
                <span classNames="employee-card-subtitle">
                    <span id="jobTitleLabel"/>
                    <span classNames="employee-card-subtitle-separator"/>
                    <span id="subdivisionLabel"/>
                </span>
                <span classNames="employee-card-subtitle">
                    <span classNames="employee-card-subtitle-contacts">
                        <icon icon="vaadin:envelope-o" size="S"/>
                        <span id="contactsLabel"/>
                    </span>
                </span>
            </vbox>
        </hbox>

        <tabSheet id="employeeCardTabSheet" width="100%" height="100%">
            <tab id="profileTab" label="msg://employeeCardView.profileTab">
                <vbox id="profileTabContent" width="100%" height="100%" padding="false"/>
            </tab>
            <tab id="careerTab" label="msg://employeeCardView.careerTab">
                <vbox id="careerTabContent" width="100%" height="100%" padding="false"/>
            </tab>
        </tabSheet>
    </layout>
</view>
