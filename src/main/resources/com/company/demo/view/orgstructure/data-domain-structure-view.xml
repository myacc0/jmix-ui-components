<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://com.company.demo/schema/app-ui-components"
      title="msg://dataDomainStructureView.title">
    <data>
        <collection id="domainsDc" class="com.company.demo.entity.dict.DictDataDomain">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="domainsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_DictDataDomain e order by e.shortName]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <split id="splitLayout" orientation="HORIZONTAL" width="100%" height="100%">
            <vbox id="domainsPanel" width="30%" height="100%">
                <treeDataGrid id="domainsTreeDataGrid"
                              dataContainer="domainsDc"
                              hierarchyProperty="parent"
                              themeNames="no-header no-row-borders compact"
                              width="100%"
                              height="100%">
                    <columns sortable="false">
                        <column property="shortName"/>
                    </columns>
                </treeDataGrid>
            </vbox>

            <vbox id="chartPanel" width="70%" height="100%">
                <textField id="domainSearchField"
                           placeholder="msg://dataDomainStructureView.search"
                           width="40%"
                           valueChangeMode="LAZY"
                           clearButtonVisible="true">
                    <suffix>
                        <icon icon="SEARCH"/>
                    </suffix>
                </textField>
                <app:d3-org-chart id="d3OrgChart" classNames="d3-org-chart" nodeTemplate="DATA_ASSET"/>
            </vbox>
        </split>
    </layout>
</view>
