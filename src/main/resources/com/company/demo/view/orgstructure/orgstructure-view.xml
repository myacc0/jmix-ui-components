<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://com.company.demo/schema/app-ui-components"
      title="msg://OrgStructureView.title">
    <data>
        <collection id="departmentsDc" class="com.company.demo.entity.orgstructure.Department">
            <fetchPlan extends="_base">
                <property name="parentDepartment" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="departmentsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_Department e order by e.ordNo]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <split id="splitLayout" orientation="HORIZONTAL" width="100%" height="100%">
            <vbox id="departmentsPanel" width="30%" height="100%">
                <textField id="departmentSearchField"
                           placeholder="msg://departmentSearch"
                           width="100%"
                           valueChangeMode="LAZY"
                           clearButtonVisible="true">
                    <suffix>
                        <icon icon="SEARCH"/>
                    </suffix>
                </textField>

                <treeDataGrid id="departmentsTreeDataGrid"
                              dataContainer="departmentsDc"
                              hierarchyProperty="parentDepartment"
                              themeNames="no-header no-row-borders compact"
                              width="100%"
                              height="100%">
                    <columns sortable="false">
                        <column property="name"/>
                    </columns>
                </treeDataGrid>
            </vbox>

            <vbox id="employeesPanel" width="70%" height="100%">
                <textField id="employeeSearchField"
                           placeholder="msg://employeeSearch"
                           width="40%"
                           valueChangeMode="LAZY"
                           clearButtonVisible="true">
                    <suffix>
                        <icon icon="SEARCH"/>
                    </suffix>
                </textField>
                <app:d3-org-chart id="d3OrgChart" classNames="d3-org-chart"/>
            </vbox>
        </split>
    </layout>
</view>
