<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://positionListView.title"
      focusComponent="positionsDataGrid">
    <data>
        <collection id="positionsDc"
                    class="com.company.demo.entity.orgstructure.Position">
            <fetchPlan>
                <property name="lvl"/>
                <property name="ishead"/>
                <property name="status"/>
                <property name="department" fetchPlan="_instance_name"/>
                <property name="jobTitle" fetchPlan="_instance_name"/>
                <property name="employee" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="positionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_Position e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="positionsDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="positionsDataGrid.createAction"/>
                <button id="editButton" action="positionsDataGrid.editAction"/>
                <button id="removeButton" action="positionsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="positionsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="positionsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="positionsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="department"/>
                <column property="jobTitle"/>
                <column property="employee"/>
                <column property="lvl"/>
                <column property="ishead"/>
                <column property="status"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
