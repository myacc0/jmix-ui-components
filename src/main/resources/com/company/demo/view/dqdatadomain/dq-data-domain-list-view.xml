<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://dqDataDomainListView.title"
      focusComponent="dqDataDomainsDataGrid">
    <data>
        <collection id="dqDataDomainsDc"
                    class="com.company.demo.entity.dq.DqDataDomain">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqDataDomainsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_DqDataDomain e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="dqDataDomainsDataGrid.createAction"/>
                <button id="editButton" action="dqDataDomainsDataGrid.editAction"/>
                <button id="removeButton" action="dqDataDomainsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="dqDataDomainsDl"/>
            </endSlot>
        </hbox>
        <treeDataGrid id="dqDataDomainsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="dqDataDomainsDc"
                  hierarchyProperty="parent"
                  columnReorderingAllowed="true"
                  showOrphans="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="parent" filterable="true"/>
                <column property="code" filterable="true"/>
                <column property="shortName" filterable="true"/>
                <column property="name" filterable="true"/>
                <column property="createdAt"/>
                <column property="updatedAt"/>
            </columns>
        </treeDataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
