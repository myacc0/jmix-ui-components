<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://productListView.title"
      focusComponent="productsDataGrid">
    <data>
        <collection id="productsDc"
                    class="com.company.demo.entity.Product">
            <fetchPlan extends="_base">
                <property name="category" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="productsDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_Product e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="productsDataGrid.createAction"/>
                <button id="editButton" action="productsDataGrid.editAction"/>
                <button id="removeButton" action="productsDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="productsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="productsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="productsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true" filterable="true">
                <column property="id" autoWidth="true" flexGrow="0"/>
                <column property="name" autoWidth="true" flexGrow="0"/>
                <column property="description" autoWidth="true" flexGrow="0"/>
                <column property="price" autoWidth="true" flexGrow="0"/>
                <column property="sale" autoWidth="true" flexGrow="0"/>
                <column property="category" autoWidth="true" flexGrow="0"/>
                <column property="quantity" autoWidth="true" flexGrow="0"/>
                <column property="createdAt" autoWidth="true" flexGrow="0"/>
                <column property="updatedAt" autoWidth="true" flexGrow="0"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
