<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://tipInfoListView.title"
      focusComponent="tipInfoesDataGrid">
    <data>
        <collection id="tipInfoesDc"
                    class="com.company.demo.entity.TipInfo">
            <fetchPlan extends="_base"/>
            <loader id="tipInfoesDl" readOnly="true">
                <query>
                    <![CDATA[select e from demo_TipInfo e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <genericFilter component="genericFilter"/>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <genericFilter id="genericFilter"
                       dataLoader="tipInfoesDl">
            <properties include=".*"/>
        </genericFilter>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" action="tipInfoesDataGrid.createAction"/>
                <button id="editButton" action="tipInfoesDataGrid.editAction"/>
                <button id="removeButton" action="tipInfoesDataGrid.removeAction"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="tipInfoesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="tipInfoesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="tipInfoesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create"/>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="totalBill"/>
                <column property="tip"/>
                <column property="smoker"/>
                <column property="size"/>
                <column property="sex"/>
                <column property="day"/>
                <column property="time"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
