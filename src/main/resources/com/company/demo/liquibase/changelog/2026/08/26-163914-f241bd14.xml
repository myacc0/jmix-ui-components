<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/demo/liquibase/changelog/2026/08/26-163914-f241bd14.xml">
    <changeSet id="1" author="demo">
        <createTable tableName="DEMO_JOB_TITLE">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DEMO_JOB_TITLE"/>
            </column>
            <column name="NAME" type="VARCHAR(400)"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="demo">
        <createTable tableName="DEMO_POSITION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DEMO_POSITION"/>
            </column>
            <column name="DEPARTMENT_ID" type="UUID"/>
            <column name="JOB_TITLE_ID" type="UUID"/>
            <column name="EMPLOYEE_ID" type="UUID"/>
            <column name="LVL" type="INT"/>
            <column name="ISHEAD" type="INT"/>
            <column name="STATUS" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>
    <changeSet id="3" author="demo">
        <createIndex indexName="IDX_DEMO_POSITION_DEPARTMENT" tableName="DEMO_POSITION">
            <column name="DEPARTMENT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="DEPARTMENT_ID" baseTableName="DEMO_POSITION"
                                 constraintName="FK_DEMO_POSITION_ON_DEPARTMENT" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEPARTMENT"/>
    </changeSet>
    <changeSet id="4" author="demo">
        <createIndex indexName="IDX_DEMO_POSITION_EMPLOYEE" tableName="DEMO_POSITION">
            <column name="EMPLOYEE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="EMPLOYEE_ID" baseTableName="DEMO_POSITION"
                                 constraintName="FK_DEMO_POSITION_ON_EMPLOYEE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="EMPLOYEE"/>
    </changeSet>
    <changeSet id="5" author="demo">
        <createIndex indexName="IDX_DEMO_POSITION_JOB_TITLE" tableName="DEMO_POSITION">
            <column name="JOB_TITLE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="JOB_TITLE_ID" baseTableName="DEMO_POSITION"
                                 constraintName="FK_DEMO_POSITION_ON_JOB_TITLE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEMO_JOB_TITLE"/>
    </changeSet>
    <changeSet id="6" author="demo">
        <dropColumn columnName="department_id" tableName="employee"/>

        <dropColumn columnName="last_name" tableName="employee"/>

        <dropColumn columnName="position" tableName="employee"/>
    </changeSet>
</databaseChangeLog>