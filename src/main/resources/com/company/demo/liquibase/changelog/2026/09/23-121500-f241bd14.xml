<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/demo/liquibase/changelog/2026/09/23-121500-f241bd14.xml">
    <changeSet id="1" author="demo">
        <createTable tableName="DEMO_QUARTZ_JOB_EXECUTION">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DEMO_QUARTZ_JOB_EXECUTION"/>
            </column>
            <column name="JOB_NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="JOB_GROUP" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="JOB_CLASS" type="VARCHAR(500)"/>
            <column name="TRIGGER_NAME" type="VARCHAR(255)"/>
            <column name="TRIGGER_GROUP" type="VARCHAR(255)"/>
            <column name="FIRE_INSTANCE_ID" type="VARCHAR(100)"/>
            <column name="STARTED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="FINISHED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="DURATION_MS" type="BIGINT"/>
            <column name="STATUS" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="JOB_PARAMS" type="text"/>
            <column name="ERROR_MESSAGE" type="text"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="demo">
        <createIndex indexName="IDX_DEMO_QUARTZ_JOB_EXECUTION_STARTED_AT"
                     tableName="DEMO_QUARTZ_JOB_EXECUTION">
            <column name="STARTED_AT"/>
        </createIndex>
    </changeSet>
    <changeSet id="3" author="demo">
        <createIndex indexName="IDX_DEMO_QUARTZ_JOB_EXECUTION_JOB_NAME"
                     tableName="DEMO_QUARTZ_JOB_EXECUTION">
            <column name="JOB_NAME"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
