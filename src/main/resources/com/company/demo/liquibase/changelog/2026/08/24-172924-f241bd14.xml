<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/demo/liquibase/changelog/2026/08/24-172924-f241bd14.xml">
    <changeSet id="1" author="demo">
        <createTable tableName="DEMO_DQ_RULE_GROUP">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DEMO_DQ_RULE_GROUP"/>
            </column>
            <column name="PARENT_ID" type="UUID"/>
            <column name="NAME" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="DOMAIN_ID" type="UUID"/>
            <column name="DATA_PRODUCT_ID" type="UUID"/>
            <column name="DESCRIPTION" type="text"/>
            <column name="CREATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="TIMESTAMP"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="demo">
        <createIndex indexName="IDX_DEMO_DQ_RULE_GROUP_DATA_PRODUCT" tableName="DEMO_DQ_RULE_GROUP">
            <column name="DATA_PRODUCT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="DATA_PRODUCT_ID" baseTableName="DEMO_DQ_RULE_GROUP"
                                 constraintName="FK_DEMO_DQ_RULE_GROUP_ON_DATA_PRODUCT" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEMO_DQ_DATA_PRODUCT"/>
    </changeSet>
    <changeSet id="3" author="demo">
        <createIndex indexName="IDX_DEMO_DQ_RULE_GROUP_DOMAIN" tableName="DEMO_DQ_RULE_GROUP">
            <column name="DOMAIN_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="DOMAIN_ID" baseTableName="DEMO_DQ_RULE_GROUP"
                                 constraintName="FK_DEMO_DQ_RULE_GROUP_ON_DOMAIN" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEMO_DQ_DATA_DOMAIN"/>
    </changeSet>
    <changeSet id="4" author="demo">
        <createIndex indexName="IDX_DEMO_DQ_RULE_GROUP_PARENT" tableName="DEMO_DQ_RULE_GROUP">
            <column name="PARENT_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="PARENT_ID" baseTableName="DEMO_DQ_RULE_GROUP"
                                 constraintName="FK_DEMO_DQ_RULE_GROUP_ON_PARENT" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEMO_DQ_RULE_GROUP"/>
    </changeSet>
</databaseChangeLog>