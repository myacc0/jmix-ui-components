        <addForeignKeyConstraint baseColumnNames="ASSIGNEE_SUBDIVISION_ID" baseTableName="DEMO_DQ_RULE"
                                 constraintName="FK_DEMO_DQ_RULE_ON_ASSIGNEE_SUBDIVISION" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEPARTMENT"/>
