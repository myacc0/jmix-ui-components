<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/demo/liquibase/changelog/2026/08/25-163001-f241bd14.xml">
    <changeSet id="1" author="demo">
        <addColumn tableName="DEMO_DQ_RULE">
            <column name="ASSIGNEE_EMPLOYEE_ID" type="UUID"/>
            <column name="ASSIGNEE_SUBDIVISION_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="demo">
        <createIndex indexName="IDX_DEMO_DQ_RULE_ASSIGNEE_EMPLOYEE" tableName="DEMO_DQ_RULE">
