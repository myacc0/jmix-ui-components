<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="com/company/demo/liquibase/changelog/2026/08/27-173735-f241bd14.xml">
    <changeSet id="1" author="demo">
        <createTable tableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_DEMO_WORK_DISCIPLINE_EXCEPTIONS"/>
            </column>
            <column name="SUBDIVISION_ID" type="UUID"/>
            <column name="EMPLOYEE_ID" type="UUID"/>
            <column name="JOB_TITLE_ID" type="UUID"/>
            <column name="START_DATE" type="TIME"/>
            <column name="END_DATE" type="TIME"/>
            <column name="DESCRIPTION" type="text"/>
        </createTable>
    </changeSet>
    <changeSet id="2" author="demo">
        <createIndex indexName="IDX_DEMO_WORK_DISCIPLINE_EXCEPTIONS_EMPLOYEE"
                     tableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS">
            <column name="EMPLOYEE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="EMPLOYEE_ID" baseTableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS"
                                 constraintName="FK_DEMO_WORK_DISCIPLINE_EXCEPTIONS_ON_EMPLOYEE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="EMPLOYEE"/>
    </changeSet>
    <changeSet id="3" author="demo">
        <createIndex indexName="IDX_DEMO_WORK_DISCIPLINE_EXCEPTIONS_JOB_TITLE"
                     tableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS">
            <column name="JOB_TITLE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="JOB_TITLE_ID" baseTableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS"
                                 constraintName="FK_DEMO_WORK_DISCIPLINE_EXCEPTIONS_ON_JOB_TITLE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEMO_JOB_TITLE"/>
    </changeSet>
    <changeSet id="4" author="demo">
        <createIndex indexName="IDX_DEMO_WORK_DISCIPLINE_EXCEPTIONS_SUBDIVISION"
                     tableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS">
            <column name="SUBDIVISION_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="SUBDIVISION_ID" baseTableName="DEMO_WORK_DISCIPLINE_EXCEPTIONS"
                                 constraintName="FK_DEMO_WORK_DISCIPLINE_EXCEPTIONS_ON_SUBDIVISION" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="DEPARTMENT"/>
    </changeSet>
</databaseChangeLog>