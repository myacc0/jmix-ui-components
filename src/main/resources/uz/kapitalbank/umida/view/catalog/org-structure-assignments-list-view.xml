<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://orgStructureAssignmentsListView.title"
      focusComponent="orgStructureAssignmentsDataGrid">
    <data>
        <collection id="orgStructureAssignmentsDc"
                    class="uz.kapitalbank.umida.entity.orgstructure.OrgStructureAssignments">
            <fetchPlan extends="_base">
                <property name="employee" fetchPlan="_instance_name"/>
                <property name="position" fetchPlan="_base">
                    <property name="subdivision" fetchPlan="_instance_name"/>
                    <property name="jobTitle" fetchPlan="_instance_name"/>
                </property>
            </fetchPlan>
            <loader id="orgStructureAssignmentsDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_OrgStructureAssignments e
                    order by e.startDate desc]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="orgStructureAssignmentsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="orgStructureAssignmentsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="orgStructureAssignmentsDc"
                  columnReorderingAllowed="true">
            <actions>
            </actions>
            <columns resizable="true" filterable="true">
                <column property="employee" autoWidth="true" flexGrow="0"/>
                <column property="position.subdivision" autoWidth="true" flexGrow="0"/>
                <column property="position.jobTitle" autoWidth="true" flexGrow="0"/>
                <column property="startDate" autoWidth="true" flexGrow="0"/>
                <column property="endDate" autoWidth="true" flexGrow="0"/>
                <column property="endReason" autoWidth="true" flexGrow="1"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
