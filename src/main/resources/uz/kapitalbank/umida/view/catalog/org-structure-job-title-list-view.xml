<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://orgStructureJobTitleListView.title"
      focusComponent="orgStructureJobTitlesDataGrid">
    <data>
        <collection id="orgStructureJobTitlesDc"
                    class="uz.kapitalbank.umida.entity.orgstructure.OrgStructureJobTitle">
            <fetchPlan extends="_base"/>
            <loader id="orgStructureJobTitlesDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_OrgStructureJobTitle e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="orgStructureJobTitlesDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="orgStructureJobTitlesDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="orgStructureJobTitlesDc"
                  columnReorderingAllowed="true">
            <actions>
            </actions>
            <columns resizable="true" filterable="true">
                <column property="name" autoWidth="true" flexGrow="0"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
