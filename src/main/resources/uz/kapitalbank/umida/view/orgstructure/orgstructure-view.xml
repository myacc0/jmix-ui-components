<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:app="http://uz.kapitalbank.umida/schema/app-ui-components"
      title="msg://OrgStructureView.title">
    <data>
        <collection id="subdivisionsDc" class="uz.kapitalbank.umida.entity.orgstructure.OrgStructureSubdivision">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="subdivisionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_OrgStructureSubdivision e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>

    <layout>
        <split id="splitLayout" orientation="HORIZONTAL" width="100%" height="100%">
            <vbox id="subdivisionsPanel" width="30%" height="100%">
                <textField id="subdivisionSearchField"
                           placeholder="msg://uz.kapitalbank.umida.view.orgstructure/subdivisionSearch"
                           width="100%"
                           valueChangeMode="LAZY"
                           clearButtonVisible="true">
                    <suffix>
                        <icon icon="SEARCH"/>
                    </suffix>
                </textField>

                <treeDataGrid id="subdivisionsTreeDataGrid"
                              dataContainer="subdivisionsDc"
                              hierarchyProperty="parent"
                              themeNames="no-header no-row-borders compact"
                              width="100%"
                              height="100%">
                    <columns sortable="false">
                        <column property="name"/>
                    </columns>
                </treeDataGrid>
            </vbox>

            <vbox id="employeesPanel" width="70%" height="100%">
                <textField id="employeeSearchField"
                           placeholder="msg://employeeSearch"
                           width="40%"
                           valueChangeMode="LAZY"
                           clearButtonVisible="true">
                    <suffix>
                        <icon icon="SEARCH"/>
                    </suffix>
                </textField>
                <app:d3-org-chart id="d3OrgChart" classNames="d3-org-chart"/>
            </vbox>
        </split>
    </layout>
</view>
