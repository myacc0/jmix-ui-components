<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://orgStructureSubdivisionListView.title"
      focusComponent="orgStructureSubdivisionsDataGrid">
    <data>
        <collection id="orgStructureSubdivisionsDc"
                    class="uz.kapitalbank.umida.entity.orgstructure.OrgStructureSubdivision">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="orgStructureSubdivisionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_OrgStructureSubdivision e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="orgStructureSubdivisionsDl"/>
            </endSlot>
        </hbox>
        <treeDataGrid id="orgStructureSubdivisionsDataGrid"
                      width="100%"
                      minHeight="20em"
                      dataContainer="orgStructureSubdivisionsDc"
                      hierarchyProperty="parent"
                      columnReorderingAllowed="true">
            <actions>
            </actions>
            <columns resizable="true" filterable="true">
                <column property="name" autoWidth="true" flexGrow="0"/>
                <column property="parent" autoWidth="true" flexGrow="0"/>
            </columns>
        </treeDataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
