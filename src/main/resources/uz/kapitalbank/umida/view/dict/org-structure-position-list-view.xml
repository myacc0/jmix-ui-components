<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://orgStructurePositionListView.title"
      focusComponent="orgStructurePositionsDataGrid">
    <data>
        <collection id="orgStructurePositionsDc"
                    class="uz.kapitalbank.umida.entity.orgstructure.OrgStructurePosition">
            <fetchPlan extends="_base">
                <property name="subdivision" fetchPlan="_instance_name"/>
                <property name="jobTitle" fetchPlan="_instance_name"/>
                <property name="employee" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="orgStructurePositionsDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_OrgStructurePosition e]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="orgStructurePositionsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="orgStructurePositionsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="orgStructurePositionsDc"
                  columnReorderingAllowed="true">
            <actions>
            </actions>
            <columns resizable="true" filterable="true">
                <column property="subdivision" autoWidth="true" flexGrow="0"/>
                <column property="jobTitle" autoWidth="true" flexGrow="0"/>
                <column property="employee" autoWidth="true" flexGrow="0"/>
                <column property="lvl" autoWidth="true" flexGrow="0"/>
                <column property="isheadofsubdivision" autoWidth="true" flexGrow="0"/>
                <column property="status" autoWidth="true" flexGrow="0"/>
                <column property="recruitmentDate" autoWidth="true" flexGrow="0"/>
                <column property="dismissalDate" autoWidth="true" flexGrow="0"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
