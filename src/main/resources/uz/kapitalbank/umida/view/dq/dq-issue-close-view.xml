<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqIssueCloseView.title"
      focusComponent="form">
    <data>
        <instance id="dqIssueDc"
                  class="uz.kapitalbank.umida.entity.dq.DqIssue">
            <fetchPlan extends="_base">
                <property name="rule" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqIssueDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveAction" type="detail_saveClose" text="msg://dqIssueCloseView.saveButton"/>
        <action id="closeAction" type="detail_close" text="msg://dqIssueCloseView.cancelButton"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="dqIssueDc" width="100%">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>
            <!-- the reasons are narrowed to the ones a user may choose in the controller -->
            <select id="closingReasonField"
                    property="closingReason"
                    required="true"
                    requiredMessage="msg://dqIssueCloseView.closingReasonRequired"/>
            <textArea id="closingNotesField" property="closingNotes" minRows="5"/>
        </formLayout>
        <hbox id="detailActions" width="100%" justifyContent="CENTER">
            <button id="cancelButton" action="closeAction" themeNames="primary"/>
            <button id="saveButton" action="saveAction" themeNames="primary"/>
        </hbox>
    </layout>
</view>
