<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      xmlns:c="http://jmix.io/schema/flowui/jpql-condition"
      title="msg://dqRuleListView.title"
      focusComponent="dqRulesDataGrid">
    <data>
        <collection id="dqRulesDc" class="uz.kapitalbank.umida.entity.dq.DqRule">
            <fetchPlan>
                <property name="id"/>
                <property name="code"/>
                <property name="name"/>
                <property name="dataSource"/>
                <property name="dbSchema"/>
                <property name="tableName"/>
                <property name="dimension"/>
                <property name="ruleType"/>
                <property name="severity"/>
                <property name="active"/>
                <property name="group" fetchPlan="_instance_name"/>
                <property name="domain" fetchPlan="_instance_name"/>
                <property name="dataProduct" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRulesDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <dropdownButton id="createButton" themeNames="primary" icon="PLUS" title="msg:///actions.Create">
                    <items>
                        <actionItem id="createItem" ref="dqRulesDataGrid.createAction"/>
                        <actionItem id="createCustomSqlItem" ref="dqRulesDataGrid.createCustomSqlAction"/>
                        <actionItem id="createCrossSourceItem" ref="dqRulesDataGrid.createCrossSourceAction"/>
                    </items>
                </dropdownButton>
                <button id="editButton" action="dqRulesDataGrid.editAction" text="" title="msg:///actions.Edit"/>
                <button id="removeButton" action="dqRulesDataGrid.removeAction" text="" title="msg:///actions.Remove"/>
                <checkbox id="mineField" label="msg://mineField.label" css="display: flex; align-items: center"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="dqRulesDl" itemsPerPageDefaultValue="20"/>
            </endSlot>
        </hbox>
        <dataGrid id="dqRulesDataGrid"
                  width="100%"
                  minHeight="20em"
                  allRowsVisible="true"
                  pageSize="20"
                  dataContainer="dqRulesDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create" text="msg://dqRuleListView.createAction"/>
                <action id="createCustomSqlAction" type="list_create" text="msg://dqRuleListView.createCustomSqlAction">
                    <properties>
                        <property name="viewId" value="umida_DqRule.customSqlDetail"/>
                    </properties>
                </action>
                <action id="createCrossSourceAction" type="list_create" text="msg://dqRuleListView.createCrossSourceAction">
                    <properties>
                        <property name="viewId" value="umida_DqRule.crossSourceDetail"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit"/>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column property="code" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="name" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="group" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="dataSource" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="dbSchema" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="tableName" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="dimension" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="ruleType" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="severity" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="active" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="domain" autoWidth="true" flexGrow="0" filterable="true"/>
                <column property="dataProduct" autoWidth="true" flexGrow="0" filterable="true"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" themeNames="primary" action="selectAction"/>
            <button id="discardButton" themeNames="primary" action="discardAction"/>
        </hbox>
    </layout>
</view>
