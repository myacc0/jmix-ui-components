<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqIssueDetailView.title">
    <data>
        <instance id="dqIssueDc"
                  class="uz.kapitalbank.umida.entity.dq.DqIssue">
            <fetchPlan extends="_base">
                <property name="rule" fetchPlan="_instance_name">
                    <property name="code"/>
                    <property name="dataSource"/>
                    <property name="severity"/>
                </property>
                <property name="checkResult">
                    <property name="status"/>
                    <property name="failedRecords"/>
                    <property name="violationsQuery"/>
                </property>
            </fetchPlan>
            <loader id="dqIssueDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="closeAction" type="detail_close" text="msg://backAction" icon="vaadin:arrow-left"/>
    </actions>
    <layout>
        <!-- an issue is maintained by the check runs: it is only ever closed here, never edited -->
        <descriptionList id="detailsList" classNames="property-list" width="100%" maxWidth="60em">
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.code"/>
            <description id="codeValue" dataContainer="dqIssueDc" property="code"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.status"/>
            <description id="statusValue"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.rule"/>
            <description id="ruleValue" dataContainer="dqIssueDc" property="rule.code"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqRule.dataSource"/>
            <description id="dataSourceValue" dataContainer="dqIssueDc" property="rule.dataSource"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqRule.severity"/>
            <description id="severityValue"/>
            <term text="msg://dqIssue.affectedRows"/>
            <description id="affectedRowsValue" dataContainer="dqIssueDc" property="checkResult.failedRecords"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.dueDate"/>
            <description id="dueDateValue" dataContainer="dqIssueDc" property="dueDate"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.resolvedAt"/>
            <description id="resolvedAtValue" dataContainer="dqIssueDc" property="resolvedAt"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.createdAt"/>
            <description id="createdAtValue" dataContainer="dqIssueDc" property="createdAt"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.updatedAt"/>
            <description id="updatedAtValue" dataContainer="dqIssueDc" property="updatedAt"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.description"/>
            <description id="descriptionValue" dataContainer="dqIssueDc" property="description"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqIssue.resolutionNotes"/>
            <description id="resolutionNotesValue" dataContainer="dqIssueDc" property="resolutionNotes"/>
        </descriptionList>
        <hbox id="detailActions" width="60%">
            <button id="closeButton" themeNames="primary" action="closeAction"/>
            <button id="closeIssueButton"
                    text="msg://dqIssueListView.closeIssueAction"
                    icon="vaadin:check"
                    themeNames="primary"/>
        </hbox>
        <vbox id="violationsBox" width="100%" height="32em" padding="false" css="padding-bottom: 40px">
            <fragment id="violationsFragment" class="uz.kapitalbank.umida.view.dq.DqViolationsFragment"/>
        </vbox>
    </layout>
</view>
