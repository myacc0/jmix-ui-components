<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqIssueDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dqIssueDc"
                  class="uz.kapitalbank.umida.entity.dq.DqIssue">
            <fetchPlan extends="_base">
                <property name="rule" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqIssueDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="dqIssueDc" width="60%">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>
            <entityPicker id="ruleField" property="rule">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <select id="statusField" property="status"/>
            <textArea id="descriptionField" property="description" minRows="5"/>
            <datePicker id="dueDateField" property="dueDate"/>
            <dateTimePicker id="resolvedAtField" property="resolvedAt"/>
            <textArea id="resolutionNotesField" property="resolutionNotes" minRows="5"/>
            <dateTimePicker id="createdAtField" property="createdAt"/>
            <dateTimePicker id="updatedAtField" property="updatedAt"/>
        </formLayout>
        <hbox id="detailActions" width="60%" justifyContent="CENTER" css="padding-bottom: 40px">
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
