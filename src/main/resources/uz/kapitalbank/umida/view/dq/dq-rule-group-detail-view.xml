<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqRuleGroupDetailView.title"
      focusComponent="form">
    <data>
        <instance id="dqRuleGroupDc"
                  class="uz.kapitalbank.umida.entity.dq.DqRuleGroup">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRuleGroupDl"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose"/>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="dqRuleGroupDc" width="50%">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>
            <textField id="nameField" property="name"/>
            <entityPicker id="parentField" property="parent">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <textArea id="descriptionField" property="description" minRows="5"/>
        </formLayout>
        <hbox id="detailActions" width="50%">
            <button id="saveAndCloseButton" themeNames="primary" action="saveCloseAction"/>
            <button id="closeButton" themeNames="primary" action="closeAction"/>
        </hbox>
    </layout>
</view>
