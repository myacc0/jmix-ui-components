<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqCheckRunViolationsView.title">
    <actions>
        <action id="closeAction" type="view_close" text="msg:///actions.Close" icon="vaadin:close"/>
    </actions>
    <layout>
        <hbox id="paginationPanel" classNames="buttons-panel" alignItems="CENTER" padding="false">
            <button id="firstPageButton" icon="vaadin:angle-double-left" themeNames="tertiary-inline"
                    enabled="false"/>
            <button id="previousPageButton" icon="vaadin:angle-left" themeNames="tertiary-inline"
                    enabled="false"/>
            <span id="pageStatusLabel"/>
            <button id="nextPageButton" icon="vaadin:angle-right" themeNames="tertiary-inline"
                    enabled="false"/>
            <button id="lastPageButton" icon="vaadin:angle-double-right" themeNames="tertiary-inline"
                    enabled="false"/>
        </hbox>
        <vbox id="violationsGridBox" width="100%" height="100%" padding="false"/>
        <hbox id="dialogActions">
            <button id="closeButton" action="closeAction"/>
        </hbox>
    </layout>
</view>
