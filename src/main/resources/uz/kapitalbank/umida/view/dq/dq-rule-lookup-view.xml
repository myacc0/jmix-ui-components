<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqRuleLookupView.title"
      focusComponent="dqRulesDataGrid">
    <!-- the page only reads: the filter is a DTO and the rules are shown read-only -->
    <data readOnly="true">
        <instance id="ruleFilterDc" class="uz.kapitalbank.umida.dto.dq.DqRuleFilter"/>
        <collection id="dqRulesDc" class="uz.kapitalbank.umida.entity.dq.DqRule">
            <!-- the same attributes as the rule grid of the check editor, which shows the selected rules -->
            <fetchPlan>
                <property name="id"/>
                <property name="code"/>
                <property name="name"/>
                <property name="active"/>
                <property name="dataSource"/>
                <property name="tableName"/>
                <property name="dimension"/>
                <property name="ruleType"/>
                <property name="severity"/>
                <property name="group" fetchPlan="_instance_name"/>
                <property name="domain" fetchPlan="_instance_name"/>
                <property name="dataProduct" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="dqRulesDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_DqRule e order by e.code]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <formLayout id="ruleFilterForm" dataContainer="ruleFilterDc" width="100%">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="40em" columns="2"/>
                <responsiveStep minWidth="64em" columns="3"/>
            </responsiveSteps>
            <select id="dataSourceField"
                    property="dataSource"
                    emptySelectionAllowed="true"
                    emptySelectionCaption="msg://form.select.not.selected"
                    label="msg://uz.kapitalbank.umida.entity.dq/DqRule.dataSource"/>
            <comboBox id="tableNameField"
                      property="tableName"
                      label="msg://uz.kapitalbank.umida.entity.dq/DqRule.tableName"
                      clearButtonVisible="true"/>
            <textField id="ruleCodeField"
                       property="ruleCode"
                       label="msg://uz.kapitalbank.umida.entity.dq/DqRule.code"
                       valueChangeMode="LAZY"
                       clearButtonVisible="true"/>
            <entityPicker id="groupField"
                          property="group"
                          label="msg://uz.kapitalbank.umida.entity.dq/DqRule.group">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="domainField"
                          property="domain"
                          label="msg://uz.kapitalbank.umida.entity.dq/DqRule.domain">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <entityPicker id="dataProductField"
                          property="dataProduct"
                          label="msg://uz.kapitalbank.umida.entity.dq/DqRule.dataProduct">
                <actions>
                    <action id="entityLookupAction" type="entity_lookup"/>
                    <action id="entityClearAction" type="entity_clear"/>
                </actions>
            </entityPicker>
            <select id="ruleTypeField"
                    property="ruleType"
                    emptySelectionAllowed="true"
                    emptySelectionCaption="msg://form.select.not.selected"
                    label="msg://uz.kapitalbank.umida.entity.dq/DqRule.ruleType"/>
            <select id="dimensionField"
                    property="dimension"
                    emptySelectionAllowed="true"
                    emptySelectionCaption="msg://form.select.not.selected"
                    label="msg://uz.kapitalbank.umida.entity.dq/DqRule.dimension"/>
            <select id="severityField"
                    property="severity"
                    emptySelectionAllowed="true"
                    emptySelectionCaption="msg://form.select.not.selected"
                    label="msg://uz.kapitalbank.umida.entity.dq/DqRule.severity"/>
        </formLayout>

        <hbox id="rulesPanel" width="100%" justifyContent="END" padding="false">
            <simplePagination id="pagination" dataLoader="dqRulesDl" itemsPerPageDefaultValue="20"/>
        </hbox>

        <dataGrid id="dqRulesDataGrid"
                  width="100%"
                  minHeight="20em"
                  pageSize="20"
                  dataContainer="dqRulesDc"
                  selectionMode="MULTI"
                  columnReorderingAllowed="true">
            <columns resizable="true">
                <column property="code" autoWidth="true" flexGrow="0"/>
                <column property="name" autoWidth="true" flexGrow="0"/>
                <column property="group" autoWidth="true" flexGrow="0"/>
                <column property="dataSource" autoWidth="true" flexGrow="0"/>
                <column property="tableName" autoWidth="true" flexGrow="0"/>
                <column property="dimension" autoWidth="true" flexGrow="0"/>
                <column property="ruleType" autoWidth="true" flexGrow="0"/>
                <column property="severity" autoWidth="true" flexGrow="0"/>
                <column property="domain" autoWidth="true" flexGrow="0"/>
                <column property="dataProduct" autoWidth="true" flexGrow="0"/>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" css="padding-bottom: 20px">
            <button id="selectButton" action="selectAction" text="msg://dqRuleLookupView.selectButton"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
