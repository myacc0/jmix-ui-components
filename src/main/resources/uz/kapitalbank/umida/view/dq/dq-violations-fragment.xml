<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://jmix.io/schema/flowui/fragment">
    <content>
        <vbox id="root" expand="violationsGridBox" classNames="violations-fragment-container">
            <div classNames="title-with-button-panel">
                <h4 id="violationsHeader" text="msg://dqIssueDetailView.violationsHeader"/>
                <hbox id="paginationPanel" classNames="buttons-panel" justifyContent="END" alignItems="CENTER" padding="false">
                    <button id="firstPageButton" icon="vaadin:angle-double-left" themeNames="tertiary-inline"
                            enabled="false"/>
                    <button id="previousPageButton" icon="vaadin:angle-left" themeNames="tertiary-inline"
                            enabled="false"/>
                    <span id="pageStatusLabel"/>
                    <button id="nextPageButton" icon="vaadin:angle-right" themeNames="tertiary-inline"
                            enabled="false"/>
                    <button id="lastPageButton" icon="vaadin:angle-double-right" themeNames="tertiary-inline"
                            enabled="false"/>
                </hbox>
            </div>
            <vbox id="violationsGridBox" width="100%" minHeight="15em" padding="false"/>
        </vbox>
    </content>
</fragment>
