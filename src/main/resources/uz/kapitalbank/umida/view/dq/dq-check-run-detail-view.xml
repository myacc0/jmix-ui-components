<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://dqCheckRunDetailView.title">
    <data>
        <instance id="dqCheckRunDc"
                  class="uz.kapitalbank.umida.entity.dq.DqCheckRun">
            <fetchPlan extends="_base">
                <property name="checkResults" fetchPlan="_base">
                    <property name="rule" fetchPlan="_instance_name">
                        <property name="code"/>
                    </property>
                </property>
            </fetchPlan>
            <loader id="dqCheckRunDl"/>
            <collection id="checkResultsDc" property="checkResults"/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="closeAction" type="detail_close"/>
    </actions>
    <layout>
        <descriptionList id="detailsList" classNames="property-list" width="100%" maxWidth="60em">
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.dataSource"/>
            <description id="dataSourceValue" dataContainer="dqCheckRunDc" property="dataSource"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.startedAt"/>
            <description id="startedAtValue" dataContainer="dqCheckRunDc" property="startedAt"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.finishedAt"/>
            <description id="finishedAtValue" dataContainer="dqCheckRunDc" property="finishedAt"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.status"/>
            <description id="statusValue"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.rulesTotal"/>
            <description id="rulesTotalValue" dataContainer="dqCheckRunDc" property="rulesTotal"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.rulesPassed"/>
            <description id="rulesPassedValue" dataContainer="dqCheckRunDc" property="rulesPassed"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.rulesFailed"/>
            <description id="rulesFailedValue" dataContainer="dqCheckRunDc" property="rulesFailed"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.rulesSkipped"/>
            <description id="rulesSkippedValue" dataContainer="dqCheckRunDc" property="rulesSkipped"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.dqScore"/>
            <description id="dqScoreValue" dataContainer="dqCheckRunDc" property="dqScore"/>
            <term text="msg://uz.kapitalbank.umida.entity.dq/DqCheckRun.errorMessage"/>
            <description id="errorMessageValue" dataContainer="dqCheckRunDc" property="errorMessage"/>
        </descriptionList>
        <hbox id="checkResultsButtonsPanel" classNames="buttons-panel">
            <button id="closeButton" themeNames="primary" action="closeAction"/>
            <button id="executedQueryButton" themeNames="primary" action="checkResultsDataGrid.executedQueryAction"/>
            <button id="violationsButton" themeNames="primary" action="checkResultsDataGrid.violationsAction"/>
        </hbox>
        <dataGrid id="checkResultsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="checkResultsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="executedQueryAction"
                        type="list_itemTracking"
                        text="msg://dqCheckRunDetailView.executedQueryAction"
                        icon="vaadin:code"/>
                <action id="violationsAction"
                        type="list_itemTracking"
                        text="msg://dqCheckRunDetailView.violationsAction"
                        icon="vaadin:file-search"/>
            </actions>
            <columns resizable="true">
                <column key="ruleCode"
                        property="rule.code"
                        header="msg://dqCheckRunDetailView.ruleColumn"
                        autoWidth="true"
                        flexGrow="0"/>
                <column property="status" autoWidth="true" flexGrow="0"/>
                <column property="totalRecords" autoWidth="true" flexGrow="0"/>
                <column property="failedRecords" autoWidth="true" flexGrow="0"/>
                <column property="passRate" autoWidth="true" flexGrow="0"/>
                <column property="executionMs" autoWidth="true" flexGrow="0"/>
                <column property="errorMessage" autoWidth="true" flexGrow="1"/>
            </columns>
        </dataGrid>
    </layout>
</view>
