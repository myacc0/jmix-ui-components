<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://reportGroupCustomListView.title"
      focusComponent="reportGroupsDataGrid">
    <data>
        <collection id="reportGroupsDc"
                    class="uz.kapitalbank.umida.entity.report.ReportGroupCustom">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_instance_name"/>
            </fetchPlan>
            <loader id="reportGroupsDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_ReportGroupCustom e order by e.title]]>
                </query>
            </loader>
        </collection>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createButton" themeNames="primary" action="reportGroupsDataGrid.createAction" text="" title="msg:///actions.Create"/>
                <button id="editButton" action="reportGroupsDataGrid.editAction" text="" title="msg:///actions.Edit"/>
                <button id="removeButton" action="reportGroupsDataGrid.removeAction" text="" title="msg:///actions.Remove"/>
            </startSlot>
            <endSlot>
                <simplePagination id="pagination" dataLoader="reportGroupsDl"/>
            </endSlot>
        </hbox>
        <dataGrid id="reportGroupsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="reportGroupsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="createAction" type="list_create">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                        <property name="viewId" value="umida_ReportGroupCustom.detail"/>
                    </properties>
                </action>
                <action id="editAction" type="list_edit">
                    <properties>
                        <property name="openMode" value="DIALOG"/>
                        <property name="viewId" value="umida_ReportGroupCustom.detail"/>
                    </properties>
                </action>
                <action id="removeAction" type="list_remove"/>
            </actions>
            <columns resizable="true">
                <column key="badge" sortable="false" flexGrow="0" width="4.5em" resizable="false"/>
                <column property="title" filterable="true"/>
                <column property="parent" filterable="true"/>
            </columns>
        </dataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction"/>
            <button id="discardButton" action="discardAction"/>
        </hbox>
    </layout>
</view>
