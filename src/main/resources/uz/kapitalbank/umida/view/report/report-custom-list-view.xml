<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://umida_ReportCustom.list.title"
      focusComponent="reportsDataGrid">
    <data>
        <collection id="reportsDc"
                    class="uz.kapitalbank.umida.entity.report.ReportCustom"
                    fetchPlan="report.view">
            <loader id="reportsDl" readOnly="true">
                <query>
                    <![CDATA[select e from umida_ReportCustom e order by e.name]]>
                </query>
            </loader>
        </collection>
        <!-- the grouped list: the reports of reportsDl, filters and order included, on a single page;
             loaded by the controller when a grouping is chosen, see ReportCustomListView#setGrouping -->
        <collection id="reportTreeItemsDc"
                    class="uz.kapitalbank.umida.dto.report.ReportTreeItem">
            <loader id="reportTreeItemsDl" readOnly="true"/>
        </collection>
    </data>
    <facets>
        <settings auto="true">
            <!-- the columns of the tree depend on the grouping, saved settings would bring back the wrong ones -->
            <component componentId="reportsTreeDataGrid" enabled="false"/>
        </settings>
        <dataLoadCoordinator>
            <refresh loader="reportsDl">
                <onViewEvent type="BeforeShow"/>
            </refresh>
        </dataLoadCoordinator>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
        <!-- the controller adds the grouping and the tiles with their folder and order, see
             ReportCustomListView.GroupingBinder and TilesBinder -->
    </facets>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
        <!-- the actions of the tiles, all of them acting on the report of the selected tile: the buttons keep
             their own look; create and import need no tile and stay with the paged list -->
        <action id="tileEdit"/>
        <action id="tileRemove"/>
        <action id="tileCopy"/>
        <action id="tileExport" visible="false"/>
        <action id="tileRunReport"/>
        <action id="tileExecutions"/>
    </actions>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel">
            <startSlot>
                <button id="createBtn" themeNames="primary" action="reportsDataGrid.create" text="" title="msg:///actions.Create"/>
                <button id="editBtn" action="reportsDataGrid.edit" text="" title="msg:///actions.Edit"/>
                <button id="removeBtn" action="reportsDataGrid.remove" text="" title="msg:///actions.Remove"/>
                <button id="copyBtn" action="reportsDataGrid.copy"/>
                <button id="importBtn" action="reportsDataGrid.importAction"/>
                <button id="exportBtn" action="reportsDataGrid.export"/>
                <button id="runReportBtn" action="reportsDataGrid.runReport"/>
                <button id="executionsBtn" action="reportsDataGrid.executions"/>
                <checkbox id="mineField" label="msg://mineField.label" css="display: flex; align-items: center"/>
            </startSlot>
            <endSlot>
                <!-- one panel always shown: the layout pushes the end slot to the right by a margin of its first
                     child, and a child created hidden gets no slot attribute in the browser and falls into the start slot -->
                <hbox id="endPanel" padding="false" alignItems="CENTER">
                    <!-- "all" shows the paged list, any other value the tree without pages -->
                    <select id="groupingField" width="12em" emptySelectionAllowed="false" classNames="padding-0"/>
                    <!-- the order of the tiles, the groups staying before the reports; back to the default in the list -->
                    <select id="tileSortField" width="13em" emptySelectionAllowed="false" classNames="padding-0"
                            visible="false"/>
                    <simplePagination id="pagination" dataLoader="reportsDl"/>
                    <!-- the list — paged or grouped — or the tiles: the groups as folders, the reports as files -->
                    <hbox id="viewModePanel" classNames="report-view-mode" padding="false" spacing="false">
                        <button id="listModeBtn" icon="umida-icons:menu" title="msg://listModeBtn.title" classNames="active"/>
                        <button id="tilesModeBtn" icon="umida-icons:blocks" title="msg://tilesModeBtn.title"/>
                    </hbox>
                </hbox>
            </endSlot>
        </hbox>
        <hbox id="folderPanel" classNames="report-folder-panel" padding="false" width="100%" visible="false">
            <button id="folderBackBtn" icon="umida-icons:arrow-left" title="msg://folderBackBtn.title"/>
            <button id="folderUpBtn" icon="umida-icons:arrow-up" title="msg://folderUpBtn.title"/>
            <span id="folderPath" classNames="report-folder-path"/>
        </hbox>
        <!-- filled by the controller, see ReportCustomListView#showFolder -->
        <div id="tilesBox" classNames="report-tiles" visible="false"/>
        <span id="tilesEmpty" classNames="report-tiles-empty" text="msg://tilesEmpty.text" visible="false"/>
        <dataGrid id="reportsDataGrid"
                  width="100%"
                  minHeight="20em"
                  dataContainer="reportsDc"
                  columnReorderingAllowed="true">
            <actions>
                <action id="create" type="list_create">
                    <properties>
                        <property name="viewId" value="umida_ReportCustom.detail"/>
                    </properties>
                </action>
                <action id="edit" type="list_edit">
                    <properties>
                        <property name="viewId" value="umida_ReportCustom.detail"/>
                    </properties>
                </action>
                <action id="remove" type="list_remove"/>
                <action id="copy" type="list_itemTracking" icon="vaadin:copy"
                        description="msg://io.jmix.reportsflowui.view.report/action.copy.text"/>
                <!-- import and export are hidden for now: drop visible="false" here, on the tree's export and on tileExport to show them -->
                <action id="importAction" icon="vaadin:upload" visible="false"
                        description="msg://io.jmix.reportsflowui.view.report/action.import.description"/>
                <action id="export" type="list_itemTracking" icon="vaadin:download" visible="false"
                        description="msg://io.jmix.reportsflowui.view.report/action.export.description"/>
                <action id="runReport" type="list_itemTracking" icon="vaadin:play"
                        description="msg://io.jmix.reportsflowui.view.report/action.runReport.text"/>
                <action id="executions" type="list_itemTracking" icon="vaadin:time-backward"
                        description="msg://io.jmix.reportsflowui.view.report/action.executions.text"/>
            </actions>
            <columns resizable="true" filterable="true">
                <column property="name"/>
                <column property="group"/>
                <column property="domain"/>
                <column property="code"/>
                <column property="updateTs"/>
                <column property="system"/>
            </columns>
        </dataGrid>
        <!-- the grouped list: the actions repeat the ones of the paged list that act on a report,
             the buttons keep their own look; create and import need no row and stay with the paged list -->
        <treeDataGrid id="reportsTreeDataGrid"
                      width="100%"
                      minHeight="20em"
                      visible="false"
                      dataContainer="reportTreeItemsDc"
                      hierarchyProperty="parent"
                      columnReorderingAllowed="true">
            <actions>
                <action id="edit" type="list_itemTracking"/>
                <action id="remove" type="list_itemTracking"/>
                <action id="copy" type="list_itemTracking"/>
                <action id="export" type="list_itemTracking" visible="false"/>
                <action id="runReport" type="list_itemTracking"/>
                <action id="executions" type="list_itemTracking"/>
            </actions>
            <columns resizable="true">
                <column key="caption"
                        property="caption"
                        header="msg://umida_ReportCustom.list.treeCaption"
                        flexGrow="2"/>
                <column key="group" property="report.group"/>
                <column key="domain" property="report.domain"/>
                <column key="code" property="report.code"/>
                <column key="updateTs" property="report.updateTs"/>
                <column key="system" property="report.system"/>
            </columns>
        </treeDataGrid>
        <hbox id="lookupActions" visible="false">
            <button id="selectBtn" action="selectAction"/>
            <button id="discardBtn" action="discardAction"/>
        </hbox>
    </layout>
</view>
