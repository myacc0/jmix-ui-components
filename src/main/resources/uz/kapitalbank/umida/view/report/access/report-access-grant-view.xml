<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="msg://reportAccessGrantView.title">
    <data>
        <!-- the reports the user manages, loaded by the controller from ReportAccessService -->
        <collection id="reportsDc" class="uz.kapitalbank.umida.entity.report.ReportCustom"/>
        <!-- the employees of the picked subdivision and below it, from ReportOwnerMemberService -->
        <collection id="employeesDc" class="uz.kapitalbank.umida.dto.report.ReportOwnerMemberItem"/>
    </data>
    <layout>
        <formLayout id="grantForm" width="100%">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
            </responsiveSteps>
            <entityComboBox id="reportField" metaClass="umida_ReportCustom" itemsContainer="reportsDc" required="true"
                            label="msg://uz.kapitalbank.umida.entity.report/ReportAccessGrant.report"/>
            <radioButtonGroup id="targetField" label="msg://targetField.label"/>
            <entityComboBox id="employeeField" metaClass="umida_OrgStructureEmployee" clearButtonVisible="true" required="true"
                            label="msg://uz.kapitalbank.umida.entity.report/ReportAccessGrant.employee">
                <itemsQuery class="uz.kapitalbank.umida.entity.orgstructure.OrgStructureEmployee"
                            searchStringFormat="(?i)%${inputString}%">
                    <fetchPlan extends="_base"/>
                    <query>
                        <![CDATA[select e from umida_OrgStructureEmployee e
                        where e.fullName like :searchString
                        and (e.dismissalDate is null or e.dismissalDate > CURRENT_DATE)
                        order by e.fullName]]>
                    </query>
                </itemsQuery>
            </entityComboBox>
            <entityComboBox id="subdivisionField" metaClass="umida_OrgStructureSubdivision" clearButtonVisible="true" required="true" visible="false"
                            label="msg://subdivisionField.label">
                <itemsQuery class="uz.kapitalbank.umida.entity.orgstructure.OrgStructureSubdivision"
                            searchStringFormat="(?i)%${inputString}%">
                    <fetchPlan extends="_instance_name">
                        <property name="parent" fetchPlan="_instance_name"/>
                    </fetchPlan>
                    <query>
                        <![CDATA[select e from umida_OrgStructureSubdivision e
                        where e.name like :searchString and (e.isActive is null or e.isActive = 1)
                        order by e.name]]>
                    </query>
                </itemsQuery>
            </entityComboBox>
            <datePicker id="validToField"
                        label="msg://uz.kapitalbank.umida.entity.report/ReportAccessGrant.validTo"
                        helperText="msg://validToField.helperText"/>
        </formLayout>
        <!-- the employees of the subdivision, all ticked at first: those ticked get the access -->
        <dataGrid id="employeesDataGrid" dataContainer="employeesDc" width="100%" height="20em"
                  selectionMode="MULTI" visible="false">
            <columns resizable="true">
                <column property="employeeName" flexGrow="2"/>
                <column property="positionName" flexGrow="2"/>
                <column property="subdivisionName" flexGrow="2"/>
            </columns>
        </dataGrid>
        <hbox id="detailActions">
            <button id="saveBtn" icon="CHECK" themeNames="primary" text="msg://saveBtn.text"/>
            <button id="cancelBtn" icon="BAN" text="msg:///actions.Cancel"/>
        </hbox>
    </layout>
</view>
