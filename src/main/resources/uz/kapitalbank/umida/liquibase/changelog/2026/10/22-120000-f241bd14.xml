<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="uz/kapitalbank/umida/liquibase/changelog/2026/10/22-120000-f241bd14.xml">

    <!-- history of the org structure: subdivisions, job titles and positions are closed instead of deleted -->
    <changeSet id="1" author="umida">
        <addColumn tableName="UMIDA_ORG_STRUCTURE_SUBDIVISIONS">
            <column name="IS_ACTIVE" type="INT" defaultValueNumeric="1"/>
            <column name="END_DATE" type="DATE"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="umida">
        <addColumn tableName="UMIDA_ORG_STRUCTURE_JOBTITLES">
            <column name="IS_ACTIVE" type="INT" defaultValueNumeric="1"/>
            <column name="END_DATE" type="DATE"/>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="umida">
        <addColumn tableName="UMIDA_ORG_STRUCTURE_POSITIONS">
            <column name="IS_ACTIVE" type="INT" defaultValueNumeric="1"/>
            <column name="END_DATE" type="DATE"/>
        </addColumn>
    </changeSet>

    <!-- OrgStructureAssignments: an employee on a position for a period -->
    <changeSet id="4" author="umida">
        <createTable tableName="UMIDA_ORG_STRUCTURE_ASSIGNMENTS">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_ORG_STRUCTURE_ASSIGNMENTS"/>
            </column>
            <column name="EMPLOYEE_ID" type="VARCHAR(36)"/>
            <column name="POSITION_ID" type="VARCHAR(36)"/>
            <column name="START_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="END_DATE" type="DATE"/>
            <column name="END_REASON" type="VARCHAR(1000)"/>
        </createTable>
    </changeSet>
    <changeSet id="5" author="umida">
        <createIndex indexName="IDX_UMIDA_ORG_STRUCTURE_ASSIGNMENTS_EMPLOYEE" tableName="UMIDA_ORG_STRUCTURE_ASSIGNMENTS">
            <column name="EMPLOYEE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="EMPLOYEE_ID" baseTableName="UMIDA_ORG_STRUCTURE_ASSIGNMENTS"
                                 constraintName="FK_UMIDA_ORG_STRUCTURE_ASSIGNMENTS_ON_EMPLOYEE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_ORG_STRUCTURE_EMPLOYEES"/>
    </changeSet>
    <changeSet id="6" author="umida">
        <createIndex indexName="IDX_UMIDA_ORG_STRUCTURE_ASSIGNMENTS_POSITION" tableName="UMIDA_ORG_STRUCTURE_ASSIGNMENTS">
            <column name="POSITION_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="POSITION_ID" baseTableName="UMIDA_ORG_STRUCTURE_ASSIGNMENTS"
                                 constraintName="FK_UMIDA_ORG_STRUCTURE_ASSIGNMENTS_ON_POSITION" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_ORG_STRUCTURE_POSITIONS"/>
    </changeSet>

    <!-- the employee of a position becomes its assignment: hired on the position on RECRUITMENT_DATE (the
         hire date of the employee, or today, when unknown), dismissed from it on DISMISSAL_DATE -->
    <changeSet id="7" author="umida">
        <sql>
            insert into UMIDA_ORG_STRUCTURE_ASSIGNMENTS (ID, EMPLOYEE_ID, POSITION_ID, START_DATE, END_DATE)
            select gen_random_uuid()::varchar, p.EMPLOYEE_ID, p.ID,
                   coalesce(p.RECRUITMENT_DATE, e.HIRE_DATE, current_date), p.DISMISSAL_DATE
            from UMIDA_ORG_STRUCTURE_POSITIONS p
                     join UMIDA_ORG_STRUCTURE_EMPLOYEES e on e.ID = p.EMPLOYEE_ID
        </sql>
    </changeSet>

    <changeSet id="8" author="umida">
        <dropForeignKeyConstraint baseTableName="UMIDA_ORG_STRUCTURE_POSITIONS"
                                  constraintName="FK_UMIDA_ORG_STRUCTURE_POSITIONS_ON_EMPLOYEE"/>
    </changeSet>
    <changeSet id="9" author="umida">
        <dropIndex indexName="IDX_UMIDA_ORG_STRUCTURE_POSITION_EMPLOYEE" tableName="UMIDA_ORG_STRUCTURE_POSITIONS"/>
    </changeSet>
    <changeSet id="10" author="umida">
        <dropColumn tableName="UMIDA_ORG_STRUCTURE_POSITIONS">
            <column name="EMPLOYEE_ID"/>
            <column name="RECRUITMENT_DATE"/>
            <column name="DISMISSAL_DATE"/>
        </dropColumn>
    </changeSet>
</databaseChangeLog>
