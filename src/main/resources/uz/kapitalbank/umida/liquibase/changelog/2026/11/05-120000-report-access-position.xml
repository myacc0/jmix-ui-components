<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="uz/kapitalbank/umida/liquibase/changelog/2026/11/05-120000-report-access-position.xml">
    <!--
        The position the employee held when a grant was given or a request made, shown and filtered in the
        access management. The org structure is written by HR outside the application: a removed position
        leaves the grant or the request without one.
    -->
    <changeSet id="1" author="umida">
        <addColumn tableName="UMIDA_REPORT_ACCESS_GRANT">
            <column name="POSITION_ID" type="VARCHAR(36)"/>
        </addColumn>
        <createIndex indexName="IDX_UMIDA_REPORT_ACCESS_GRANT_POSITION" tableName="UMIDA_REPORT_ACCESS_GRANT">
            <column name="POSITION_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="POSITION_ID" baseTableName="UMIDA_REPORT_ACCESS_GRANT"
                                 constraintName="FK_UMIDA_REPORT_ACCESS_GRANT_ON_POSITION" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_ORG_STRUCTURE_POSITIONS"/>
    </changeSet>

    <changeSet id="2" author="umida">
        <addColumn tableName="UMIDA_REPORT_ACCESS_REQUEST">
            <column name="POSITION_ID" type="VARCHAR(36)"/>
        </addColumn>
        <createIndex indexName="IDX_UMIDA_REPORT_ACCESS_REQUEST_POSITION" tableName="UMIDA_REPORT_ACCESS_REQUEST">
            <column name="POSITION_ID"/>
        </createIndex>
        <addForeignKeyConstraint baseColumnNames="POSITION_ID" baseTableName="UMIDA_REPORT_ACCESS_REQUEST"
                                 constraintName="FK_UMIDA_REPORT_ACCESS_REQUEST_ON_POSITION" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_ORG_STRUCTURE_POSITIONS"/>
    </changeSet>

    <!--
        The rows made before: the position held on the day of the row, as ReportAccessService picks it — the
        assignment in force that day first, a head position first, the latest assignment first.
    -->
    <changeSet id="3" author="umida">
        <sql>
            UPDATE UMIDA_REPORT_ACCESS_GRANT g
            SET POSITION_ID = (
                SELECT a.POSITION_ID
                FROM UMIDA_ORG_STRUCTURE_ASSIGNMENTS a
                         JOIN UMIDA_ORG_STRUCTURE_POSITIONS p ON p.ID = a.POSITION_ID
                WHERE a.EMPLOYEE_ID = g.EMPLOYEE_ID
                  AND a.START_DATE &lt;= COALESCE(CAST(g.CREATED_DATE AS DATE), g.VALID_FROM)
                ORDER BY (a.END_DATE IS NULL OR a.END_DATE &gt;= COALESCE(CAST(g.CREATED_DATE AS DATE), g.VALID_FROM)) DESC,
                         (p.ISHEADOFSUBDIVISION = 1) IS TRUE DESC,
                         a.START_DATE DESC,
                         a.ID
                LIMIT 1)
            WHERE g.POSITION_ID IS NULL
        </sql>
        <sql>
            UPDATE UMIDA_REPORT_ACCESS_REQUEST q
            SET POSITION_ID = (
                SELECT a.POSITION_ID
                FROM UMIDA_ORG_STRUCTURE_ASSIGNMENTS a
                         JOIN UMIDA_ORG_STRUCTURE_POSITIONS p ON p.ID = a.POSITION_ID
                WHERE a.EMPLOYEE_ID = q.EMPLOYEE_ID
                  AND a.START_DATE &lt;= COALESCE(CAST(q.CREATED_DATE AS DATE), CURRENT_DATE)
                ORDER BY (a.END_DATE IS NULL OR a.END_DATE &gt;= COALESCE(CAST(q.CREATED_DATE AS DATE), CURRENT_DATE)) DESC,
                         (p.ISHEADOFSUBDIVISION = 1) IS TRUE DESC,
                         a.START_DATE DESC,
                         a.ID
                LIMIT 1)
            WHERE q.POSITION_ID IS NULL
        </sql>
        <rollback/>
    </changeSet>
</databaseChangeLog>
