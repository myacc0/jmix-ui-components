<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="uz/kapitalbank/umida/liquibase/changelog/2026/10/12-150000-f241bd14.xml">
    <!-- the subdivision responsible for an issue, taken from its rule when the issue is opened -->
    <changeSet id="1" author="umida">
        <addColumn tableName="UMIDA_DQ_ISSUE">
            <column name="ASSIGNEE_ID" type="VARCHAR(36)"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="umida">
        <createIndex indexName="IDX_UMIDA_DQ_ISSUE_ASSIGNEE" tableName="UMIDA_DQ_ISSUE">
            <column name="ASSIGNEE_ID"/>
        </createIndex>

        <addForeignKeyConstraint baseColumnNames="ASSIGNEE_ID" baseTableName="UMIDA_DQ_ISSUE"
                                 constraintName="FK_UMIDA_DQ_ISSUE_ON_ASSIGNEE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_ORG_STRUCTURE_SUBDIVISIONS"/>
    </changeSet>
    <!-- the issues opened before take the current assignee of their rule: the earlier one is not known -->
    <changeSet id="3" author="umida">
        <sql>
            UPDATE UMIDA_DQ_ISSUE i
            SET ASSIGNEE_ID = r.ASSIGNEE_ID
            FROM UMIDA_DQ_RULE r
            WHERE r.ID = i.RULE_ID
              AND i.ASSIGNEE_ID IS NULL
        </sql>
        <rollback/>
    </changeSet>
</databaseChangeLog>
