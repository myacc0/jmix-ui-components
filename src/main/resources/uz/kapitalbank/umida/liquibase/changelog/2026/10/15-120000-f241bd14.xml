<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="uz/kapitalbank/umida/liquibase/changelog/2026/10/15-120000-f241bd14.xml">
    <!-- DqCheck: a named set of rules that is run as a whole -->
    <changeSet id="1" author="umida">
        <createTable tableName="UMIDA_DQ_CHECK">
            <column name="ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_DQ_CHECK"/>
            </column>
            <column name="CODE" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="text"/>
            <column name="VERSION" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="CREATED_BY" type="VARCHAR(255)"/>
            <column name="CREATED_DATE" type="${offsetDateTime.type}"/>
            <column name="LAST_MODIFIED_BY" type="VARCHAR(255)"/>
            <column name="LAST_MODIFIED_DATE" type="${offsetDateTime.type}"/>
            <column name="DELETED_BY" type="VARCHAR(255)"/>
            <column name="DELETED_DATE" type="${offsetDateTime.type}"/>
        </createTable>
    </changeSet>

    <!-- DqCheck.rules -->
    <changeSet id="2" author="umida">
        <createTable tableName="UMIDA_DQ_CHECK_RULE_LINK">
            <column name="CHECK_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_DQ_CHECK_RULE_LINK"/>
            </column>
            <column name="RULE_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_DQ_CHECK_RULE_LINK"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet id="3" author="umida">
        <addForeignKeyConstraint baseColumnNames="CHECK_ID" baseTableName="UMIDA_DQ_CHECK_RULE_LINK"
                                 constraintName="FK_DQCHERUL_ON_DQ_CHECK"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_DQ_CHECK"/>
    </changeSet>
    <changeSet id="4" author="umida">
        <addForeignKeyConstraint baseColumnNames="RULE_ID" baseTableName="UMIDA_DQ_CHECK_RULE_LINK"
                                 constraintName="FK_DQCHERUL_ON_DQ_RULE"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_DQ_RULE"/>
    </changeSet>
    <changeSet id="5" author="umida">
        <createIndex indexName="IDX_UMIDA_DQ_CHECK_RULE_LINK_RULE" tableName="UMIDA_DQ_CHECK_RULE_LINK">
            <column name="RULE_ID"/>
        </createIndex>
    </changeSet>

    <!-- Source of DqCheck.code ('DQC-100', 'DQC-101', ...), read through io.jmix.data.Sequences -->
    <changeSet id="6" author="umida">
        <createSequence sequenceName="UMIDA_DQ_CHECK_CODE_SEQ" startValue="100" incrementBy="1" minValue="0"/>
    </changeSet>

    <!-- a check run belongs to the check it ran instead of a data source -->
    <changeSet id="7" author="umida">
        <addColumn tableName="UMIDA_DQ_CHECK_RUN">
            <column name="CHECK_ID" type="UUID"/>
        </addColumn>
    </changeSet>
    <changeSet id="8" author="umida">
        <addForeignKeyConstraint baseColumnNames="CHECK_ID" baseTableName="UMIDA_DQ_CHECK_RUN"
                                 constraintName="FK_UMIDA_DQ_CHECK_RUN_ON_CHECK"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_DQ_CHECK"/>
    </changeSet>
    <changeSet id="9" author="umida">
        <createIndex indexName="IDX_UMIDA_DQ_CHECK_RUN_CHECK" tableName="UMIDA_DQ_CHECK_RUN">
            <column name="CHECK_ID"/>
        </createIndex>
    </changeSet>

    <!-- the data source moves from the run to each of its results, which the violating records are read from -->
    <changeSet id="10" author="umida">
        <addColumn tableName="UMIDA_DQ_CHECK_RUN_RESULT">
            <column name="DATA_SOURCE" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>
    <changeSet id="11" author="umida">
        <sql>
            update UMIDA_DQ_CHECK_RUN_RESULT r
            set DATA_SOURCE = (select c.DATA_SOURCE from UMIDA_DQ_CHECK_RUN c where c.ID = r.CHECK_RUN_ID)
        </sql>
    </changeSet>
    <changeSet id="12" author="umida">
        <dropColumn columnName="DATA_SOURCE" tableName="UMIDA_DQ_CHECK_RUN"/>
    </changeSet>
</databaseChangeLog>
