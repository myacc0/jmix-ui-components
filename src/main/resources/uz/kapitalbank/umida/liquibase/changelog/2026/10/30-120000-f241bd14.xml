<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="uz/kapitalbank/umida/liquibase/changelog/2026/10/30-120000-f241bd14.xml">
    <!--
        umida_ReportCustom replaces report_Report in the REPORT_REPORT table (single-table
        inheritance). The discriminator column tells the rows apart, so the reports stored before the
        replacement are marked as the replacing entity, or they would no longer be loaded.
    -->
    <changeSet id="1" author="umida">
        <addColumn tableName="REPORT_REPORT">
            <column name="DTYPE" type="VARCHAR(31)"/>
        </addColumn>

        <update tableName="REPORT_REPORT">
            <column name="DTYPE" value="umida_ReportCustom"/>
            <where>DTYPE is null</where>
        </update>
    </changeSet>
    <changeSet id="2" author="umida">
        <addColumn tableName="REPORT_REPORT">
            <column name="PERSONAL_DATA" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="CONFIDENTIAL_DATA" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="COMMERCIAL_DATA" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="BANK_DATA" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="DOMAIN_ID" type="INT"/>
        </addColumn>

        <addForeignKeyConstraint baseColumnNames="DOMAIN_ID" baseTableName="REPORT_REPORT"
                                 constraintName="FK_REPORT_REPORT_ON_DOMAIN"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_DICT_DATA_DOMAIN"/>
    </changeSet>
    <changeSet id="3" author="umida">
        <createTable tableName="UMIDA_REPORT_SECONDARY_DOMAIN_LINK">
            <column name="REPORT_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_REPORT_SECONDARY_DOMAIN_LINK"/>
            </column>
            <column name="DOMAIN_ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_REPORT_SECONDARY_DOMAIN_LINK"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="REPORT_ID" baseTableName="UMIDA_REPORT_SECONDARY_DOMAIN_LINK"
                                 constraintName="FK_REPSECDOM_ON_REPORT"
                                 referencedColumnNames="ID" referencedTableName="REPORT_REPORT"/>

        <addForeignKeyConstraint baseColumnNames="DOMAIN_ID" baseTableName="UMIDA_REPORT_SECONDARY_DOMAIN_LINK"
                                 constraintName="FK_REPSECDOM_ON_DOMAIN"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_DICT_DATA_DOMAIN"/>

        <createIndex indexName="IDX_UMIDA_REPORT_SECONDARY_DOMAIN_LINK_DOMAIN"
                     tableName="UMIDA_REPORT_SECONDARY_DOMAIN_LINK">
            <column name="DOMAIN_ID"/>
        </createIndex>
    </changeSet>
    <changeSet id="4" author="umida">
        <createTable tableName="UMIDA_REPORT_DATA_PRODUCT_LINK">
            <column name="REPORT_ID" type="UUID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_REPORT_DATA_PRODUCT_LINK"/>
            </column>
            <column name="DATA_PRODUCT_ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_UMIDA_REPORT_DATA_PRODUCT_LINK"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseColumnNames="REPORT_ID" baseTableName="UMIDA_REPORT_DATA_PRODUCT_LINK"
                                 constraintName="FK_REPDATPRO_ON_REPORT"
                                 referencedColumnNames="ID" referencedTableName="REPORT_REPORT"/>

        <addForeignKeyConstraint baseColumnNames="DATA_PRODUCT_ID" baseTableName="UMIDA_REPORT_DATA_PRODUCT_LINK"
                                 constraintName="FK_REPDATPRO_ON_DATA_PRODUCT"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_DICT_DATA_PRODUCT"/>

        <createIndex indexName="IDX_UMIDA_REPORT_DATA_PRODUCT_LINK_DATA_PRODUCT"
                     tableName="UMIDA_REPORT_DATA_PRODUCT_LINK">
            <column name="DATA_PRODUCT_ID"/>
        </createIndex>
    </changeSet>

    <!-- Source of ReportCustom.code ('R-1000', 'R-1001', ...), read through io.jmix.data.Sequences -->
    <changeSet id="5" author="umida">
        <createSequence sequenceName="UMIDA_REPORT_CODE_SEQ" startValue="1000" incrementBy="1" minValue="0"/>
    </changeSet>

    <!-- The markers are not mandatory: a required check box does not accept being unchecked. -->
    <changeSet id="6" author="umida">
        <dropNotNullConstraint tableName="REPORT_REPORT" columnName="PERSONAL_DATA" columnDataType="BOOLEAN"/>
        <dropNotNullConstraint tableName="REPORT_REPORT" columnName="CONFIDENTIAL_DATA" columnDataType="BOOLEAN"/>
        <dropNotNullConstraint tableName="REPORT_REPORT" columnName="COMMERCIAL_DATA" columnDataType="BOOLEAN"/>
        <dropNotNullConstraint tableName="REPORT_REPORT" columnName="BANK_DATA" columnDataType="BOOLEAN"/>
    </changeSet>
</databaseChangeLog>
