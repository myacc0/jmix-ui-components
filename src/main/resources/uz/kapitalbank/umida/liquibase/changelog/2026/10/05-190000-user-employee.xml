<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS"
        logicalFilePath="uz/kapitalbank/umida/liquibase/changelog/2026/10/05-190000-user-employee.xml">
    <changeSet id="1" author="umida">
        <addColumn tableName="UMIDA_USER">
            <column name="EMPLOYEE_ID" type="VARCHAR(36)"/>
        </addColumn>
    </changeSet>
    <changeSet id="2" author="umida">
        <!-- one employee belongs to one user at most; NULLs do not collide -->
        <createIndex indexName="IDX_UMIDA_USER_ON_EMPLOYEE" tableName="UMIDA_USER" unique="true">
            <column name="EMPLOYEE_ID"/>
        </createIndex>

        <!-- the HR synchronization deletes the employees missing in the source, which must unlink the user
             rather than fail the synchronization -->
        <addForeignKeyConstraint baseColumnNames="EMPLOYEE_ID" baseTableName="UMIDA_USER"
                                 constraintName="FK_UMIDA_USER_ON_EMPLOYEE" onDelete="SET NULL"
                                 referencedColumnNames="ID" referencedTableName="UMIDA_ORG_STRUCTURE_EMPLOYEES"/>
    </changeSet>
</databaseChangeLog>
